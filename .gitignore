# Overwrite the existing .gitignore with proper rules
@"
# Dependencies
node_modules/
# Package lock files should be committed for production deployments
# package-lock.json

# Environment variables
.env
.env.local
.env.production
.env.development
backend/.env
receipt-scanner/.env

# Uploads and temporary files
backend/uploads/*
!backend/uploads/.gitkeep
backend/public/reports/*
!backend/public/reports/.gitkeep

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
receipt-scanner/build/
receipt-scanner/dist/
backend/dist/

# Testing
coverage/

# Misc
.cache/
"@ | Out-File -FilePath .gitignore -Encoding UTF8